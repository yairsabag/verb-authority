{
  "name": "purchase_bid",
  "description": "Submit an NFT auction bid for a server-selected destination.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "tokenId": {
        "type": "integer",
        "minimum": 0,
        "description": "ID of the NFT under auction"
      },
      "bidWei": {
        "type": "string",
        "pattern": "^[0-9]+$",
        "description": "Bid amount in wei (decimal string)"
      }
    },
    "required": [
      "tokenId",
      "bidWei"
    ],
    "additionalProperties": false
  }
}
